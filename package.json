{
  "name": "@passioncode-ai/fabric-agent-adapter",
  "version": "0.5.2",
  "description": "Create Fabric-compatible agents, run them as always-alive local services with dashboards (fabric-service/0.1), and adapt existing projects to the Fabric Agent Contract. This package is the installer CLI.",
  "scripts": {
    "test": "python3 test/validate.py && python3 -m unittest discover -s test -q && node --test 'test/*.test.mjs'"
  },
  "bin": {
    "fabric-agent-adapter": "bin/fabric-agent-adapter.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "plugins",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "repository": "github:passioncode-ai/fabric-agent-adapter",
  "homepage": "https://github.com/passioncode-ai/fabric-agent-adapter",
  "license": "PolyForm-Noncommercial-1.0.0 OR LicenseRef-PolyForm-Internal-Use-1.0.0",
  "author": {
    "name": "PassionCode.ai",
    "url": "https://passioncode.ai/"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "fabric",
    "agent",
    "compatibility",
    "mcp",
    "a2a",
    "local-runner",
    "provider",
    "conformance",
    "claude-code",
    "skill",
    "local-service",
    "dashboard",
    "launchd"
  ]
}
