{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents.example/fabric/schemas/capability-output.schema.json",
  "title": "Capability output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "summary",
    "evidence"
  ]
}
