 "reasons": {
  "ok": "Allowed by a rule of a group this login belongs to.",
  "bind-not-loopback": "The service does not listen on a loopback address only, so a Tailscale identity header could come from the network and is not believed.",
  "not-loopback": "The request did not come from the local tailscale serve proxy (its peer is not a loopback address), so its Tailscale identity header is not believed.",
  "groups-unreadable": "The tailnet groups file cannot be read, so every door stays closed until it can.",
  "groups-invalid": "The tailnet groups file is not a valid tailnet-groups/1 or door-groups/1 document, so every door stays closed until it is fixed.",
  "funnel-request": "The request came through Tailscale Funnel from the public internet, which carries no tailnet identity.",
  "no-login": "The request carries no Tailscale-User-Login header, so the caller is not known.",
  "tagged-node": "The request came through tailscale serve from a tailnet node with no user (a tagged node), which carries no login.",
  "login-ambiguous": "The request carries more than one Tailscale-User-Login header.",
  "login-malformed": "The Tailscale-User-Login header is not a login name.",
  "unknown-login": "This login is in no group of the tailnet groups file.",
  "not-allowed": "No group of this login has a rule that opens this door for this capability."
 },
