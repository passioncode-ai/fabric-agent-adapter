 "scenarios": [
  {
   "name": "an answer on the first try",
   "method": "GET",
   "steps": [
    {
     "status": 200,
     "body": "{\"a\":1}"
    }
   ],
   "expect": {
    "status": 200,
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "two 503 then 200 with backoff",
   "method": "GET",
   "retries": 2,
   "steps": [
    {
     "status": 503
    },
    {
     "status": 503
    },
    {
     "status": 200
    }
   ],
   "expect": {
    "status": 200,
    "attempts": 3,
    "sleeps": [
     0.5,
     1
    ]
   }
  },
  {
   "name": "retries spent: the last answer stands",
   "method": "GET",
   "retries": 1,
   "steps": [
    {
     "status": 502
    },
    {
     "status": 502
    }
   ],
   "expect": {
    "status": 502,
    "attempts": 2,
    "sleeps": [
     0.5
    ]
   }
  },
  {
   "name": "Retry-After replaces the backoff",
   "method": "GET",
   "steps": [
    {
     "status": 429,
     "headers": {
      "Retry-After": "3"
     }
    },
    {
     "status": 200
    }
   ],
   "expect": {
    "status": 200,
    "attempts": 2,
    "sleeps": [
     3
    ]
   }
  },
  {
   "name": "Retry-After over the cap is not waited",
   "method": "GET",
   "maxRetryAfterS": 30,
   "steps": [
    {
     "status": 503,
     "headers": {
      "Retry-After": "120"
     }
    }
   ],
   "expect": {
    "status": 503,
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "a wait past the deadline is not taken",
   "method": "GET",
   "deadlineS": 5,
   "steps": [
    {
     "status": 429,
     "headers": {
      "Retry-After": "6"
     }
    }
   ],
   "expect": {
    "status": 429,
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "POST is not retried on 503",
   "method": "POST",
   "body": {
    "q": 1
   },
   "steps": [
    {
     "status": 503
    }
   ],
   "expect": {
    "status": 503,
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "POST is retried on 429",
   "method": "POST",
   "body": {
    "q": 1
   },
   "steps": [
    {
     "status": 429
    },
    {
     "status": 200
    }
   ],
   "expect": {
    "status": 200,
    "attempts": 2,
    "sleeps": [
     0.5
    ]
   }
  },
  {
   "name": "POST with an Idempotency-Key is retried on 503",
   "method": "POST",
   "headers": {
    "Idempotency-Key": "k1"
   },
   "steps": [
    {
     "status": 503
    },
    {
     "status": 201
    }
   ],
   "expect": {
    "status": 201,
    "attempts": 2,
    "sleeps": [
     0.5
    ]
   }
  },
  {
   "name": "a connection error then an answer",
   "method": "GET",
   "steps": [
    {
     "error": "connection"
    },
    {
     "status": 200
    }
   ],
   "expect": {
    "status": 200,
    "attempts": 2,
    "sleeps": [
     0.5
    ]
   }
  },
  {
   "name": "connection errors exhaust the retries",
   "method": "GET",
   "retries": 1,
   "steps": [
    {
     "error": "connection"
    },
    {
     "error": "connection"
    }
   ],
   "expect": {
    "error": "connection",
    "attempts": 2,
    "sleeps": [
     0.5
    ]
   }
  },
  {
   "name": "a timeout of a POST is not retried",
   "method": "POST",
   "body": "x",
   "steps": [
    {
     "error": "timeout"
    }
   ],
   "expect": {
    "error": "timeout",
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "a body over the cap is an error",
   "method": "GET",
   "maxBytes": 4,
   "steps": [
    {
     "status": 200,
     "body": "12345"
    }
   ],
   "expect": {
    "error": "too-large",
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "a body at the cap is an answer",
   "method": "GET",
   "maxBytes": 4,
   "steps": [
    {
     "status": 200,
     "body": "1234"
    }
   ],
   "expect": {
    "status": 200,
    "attempts": 1,
    "sleeps": []
   }
  },
  {
   "name": "a 4xx is answered as it came",
   "method": "GET",
   "steps": [
    {
     "status": 404
    }
   ],
   "expect": {
    "status": 404,
    "attempts": 1,
    "sleeps": []
   }
  }
